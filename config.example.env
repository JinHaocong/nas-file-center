# Host paths on 极空间/NAS
# Map the highest common data directory you want this service to manage.
HOST_DATA_DIR=/tmp/zfsv3/sata11/USER_ID/data
HOST_CONFIG_DIR=/tmp/zfsv3/nvme13/USER_ID/appdata/nas-file-center

# Web
WEB_PORT=8080

# Container-visible roots. Keep /data unless you intentionally narrow it.
ALLOWED_ROOTS=/data
QUARANTINE_ROOT=/data/.nas-file-center-trash

# SAFE MODE DEFAULTS
# ro + false means the application is physically unable to modify source data.
DATA_MODE=ro
ALLOW_MUTATION=false
ALLOW_DELETE=false
PROTECT_LAST_FILE=true

# fclones
FCLONES_VERSION=0.35.0
# Leave blank for fclones automatic device-aware tuning.
FCLONES_THREADS=

# Organizer workflow helper
MTIME_REFRESH_DELAY_SECONDS=2
